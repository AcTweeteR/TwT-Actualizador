                    <label>$LOCALIZE[32034]</label>
                    <onclick>PreviousMenu</onclick>
                    <textcolor>FFFFFFFF</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
                    <texturefocus border="10" colordiffuse="FFCD2028">diffuse/panel.png</texturefocus>
                    <texturenofocus border="10" colordiffuse="E0262626">diffuse/panel.png</texturenofocus>
