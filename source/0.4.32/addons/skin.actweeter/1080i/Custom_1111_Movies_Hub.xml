<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<window id="1111">
    <defaultcontrol always="true">77777</defaultcontrol>
    <menucontrol>900</menucontrol>
    <include>CustomBingieWinProps</include>
    <include>BingieViews_WindowOpen_Fade</include>
	<!-- Let Kodi restore the hub ListItem after playback ends before reopening its information dialog. -->
	<onfocus condition="!String.IsEmpty(Window(Home).Property(VOD_RETURN_PENDING)) + !Window.IsActive(DialogVideoInfo.xml) + !System.HasAlarm(VODReturnInfo)">AlarmClock(VODReturnInfo,Action(Info),00:00:03,silent)</onfocus>
	<onunload condition="System.HasAlarm(VODReturnInfo)">CancelAlarm(VODReturnInfo,silent)</onunload>
	<onunload condition="System.HasAddon(slyguy.trailers)">ClearProperty(ACTWEETER_AUTO_PREVIEW_REQUEST,Home)</onunload>
	<onunload condition="System.HasAddon(slyguy.trailers)">RunScript(service.actweeter,preview_exit)</onunload>
	<onload>Skin.TimerStart(spotlightanimation)</onload>
    <controls>
		<include>Defs_TMDbBingieHelper_Loader</include>
        <!-- fake go-to-fullscreen button -->
        <control type="button" id="509">
            <visible allowhiddenfocus="true">false</visible>
            <onfocus>FullScreen</onfocus>
        </control>
        <include>GlobalBackground</include>
        <!-- hidden submenu for count calculations -->
        <include condition="!Skin.HasSetting(DisableAllSubmenus)">hiddenSubmenu</include>
        <include>HomeBingie</include>
        <include>AcTweeteR_TouchDiagnosticsOverlay</include>
        <include condition="Skin.HasSetting(DebugGrid) | Skin.HasSetting(DebugInfo)">DebugInfo</include>
    </controls>
</window>
