<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<window>
    <defaultcontrol always="true">8000</defaultcontrol>
	<onload condition="!String.IsEqual(ListItem.Property(tmdb_type),person)">SetFocus(8000)</onload>
	<onload condition="String.IsEqual(ListItem.Property(tmdb_type),person)">SetFocus(2999,0)</onload>
	<onload condition="!String.IsEmpty(Window.Property(AdditionalInfo))">ClearProperty(AdditionalInfo)</onload>
	<onload condition="!String.IsEmpty(Window(Home).Property(VOD_RETURN_PENDING))">ClearProperty(VOD_RETURN_PENDING,Home)</onload>
	<onload condition="!String.IsEmpty(Window(Home).Property(SLYGUY_TRAILER_RETURN_PENDING))">ClearProperty(SLYGUY_TRAILER_RETURN_PENDING,Home)</onload>
	<onload condition="!String.IsEmpty(Window(Home).Property(SLYGUY_TRAILER_RETURN_ID))">ClearProperty(SLYGUY_TRAILER_RETURN_ID,Home)</onload>
	<onload condition="!String.IsEmpty(Window(Home).Property(SLYGUY_TRAILER_RETURN_REQUEST))">ClearProperty(SLYGUY_TRAILER_RETURN_REQUEST,Home)</onload>
	<onload condition="!String.IsEmpty(Window(Home).Property(SLYGUY_TRAILER_RETURN_PLAYBACK_STARTED))">ClearProperty(SLYGUY_TRAILER_RETURN_PLAYBACK_STARTED,Home)</onload>
	<!-- If the user cancels before a player starts, discard the request. Active playback is handled by the service Player callbacks. -->
	<onunload condition="!Player.HasVideo + String.IsEmpty(Window(Home).Property(SLYGUY_TRAILER_RETURN_PLAYBACK_STARTED)) + !String.IsEmpty(Window(Home).Property(SLYGUY_TRAILER_RETURN_PENDING))">ClearProperty(SLYGUY_TRAILER_RETURN_PENDING,Home)</onunload>
	<onunload condition="!Player.HasVideo + String.IsEmpty(Window(Home).Property(SLYGUY_TRAILER_RETURN_PLAYBACK_STARTED)) + !String.IsEmpty(Window(Home).Property(SLYGUY_TRAILER_RETURN_ID))">ClearProperty(SLYGUY_TRAILER_RETURN_ID,Home)</onunload>
	<onunload condition="!Player.HasVideo + String.IsEmpty(Window(Home).Property(SLYGUY_TRAILER_RETURN_PLAYBACK_STARTED)) + !String.IsEmpty(Window(Home).Property(SLYGUY_TRAILER_RETURN_REQUEST))">ClearProperty(SLYGUY_TRAILER_RETURN_REQUEST,Home)</onunload>
	<onload condition="!String.IsEmpty(Window.Property(ShowPlayBeginning))">ClearProperty(ShowPlayBeginning)</onload>
    <onload condition="!String.IsEmpty(Window(Home).Property(ListItem.TVShowID))">ClearProperty(ListItem.TVShowID,Home)</onload>
    <onload condition="!String.IsEmpty(ListItem.DBID) + [String.IsEqual(ListItem.DBTYPE,episode) | String.IsEqual(ListItem.Property(DBTYPE),episode)]">RunScript(script.bingie.helper,action=gettvshowid,dbid=$INFO[ListItem.DBID])</onload>
    <onload condition="!String.IsEmpty(Window(Home).Property(BaseWindow))">ClearProperty(BaseWindow,Home)</onload>
	<onload condition="System.HasAlarm(preview_delay)">CancelAlarm(preview_delay,true)</onload>
    <onload condition="!String.IsEmpty(ListItem.DBID) + [String.IsEqual(ListItem.DBTYPE,tvshow) | String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,episode)]">RunScript(script.bingie.helper,action=ismylist)</onload>
   	<onload condition="!String.IsEmpty(Window(Home).Property(NoFadeOut))">ClearProperty(NoFadeOut,home)</onload>
    <onunload condition="!String.IsEmpty(Window(Home).Property(ListItem.TVShowID)) + String.IsEmpty(Window(Home).Property(KeepTVShowID))">ClearProperty(ListItem.TVShowID,Home)</onunload>
    <onunload condition="!String.IsEmpty(Window(Home).Property(IsInMyList))">ClearProperty(IsInMyList,Home)</onunload>
    <onunload condition="!String.IsEmpty(Window(Home).Property(RateTitle))">ClearProperty(RateTitle,Home)</onunload>
    <onunload condition="!String.IsEmpty(Window(Home).Property(RateTitle.Action))">ClearProperty(RateTitle.Action,Home)</onunload>
	<onunload condition="!String.IsEmpty(Window.Property(AdditionalInfo))">ClearProperty(AdditionalInfo)</onunload>
	<onunload condition="!String.IsEmpty(Window.Property(VODPlaybackContext))">ClearProperty(VODPlaybackContext)</onunload>
	<onunload condition="!String.IsEmpty(Window.Property(ShowPlayBeginning))">ClearProperty(ShowPlayBeginning)</onunload>
	<onunload condition="!String.IsEmpty(Window.Property(PlaySearchTrailer))">ClearProperty(PlaySearchTrailer)</onunload>
	<onload condition="![String.IsEqual(ListItem.Path,plugin://plugin.video.tmdb.bingie.helper/) | !String.IsEmpty(ListItem.DBID)]">SetProperty(SetCustomAddon,1,Home)</onload>
    <controls>
		<include>Defs_TMDbBingieHelper_Loader</include>
        <!-- Playback changes after this dialog loads; visibility must be evaluated dynamically. -->
        <control type="group">
            <visible>!Player.HasVideo | String.IsEmpty(Window(Home).Property(SLYGUY_TRAILER_RETURN_PENDING))</visible>
            <include condition="Skin.HasSetting(UseBingieInfoDialog)">BingieInfo</include>
            <include condition="!Skin.HasSetting(UseBingieInfoDialog)">BingieAltInfo</include>
        </control>
		<include condition="String.IsEqual(ListItem.Property(tmdb_type),person)">TMDB_Helper_Cast</include>
		<include condition="Skin.HasSetting(DebugGrid) | Skin.HasSetting(DebugInfo)">DebugInfo</include>
        <include>AcTweeteR_TouchDiagnosticsOverlay</include>
	</controls>
</window>
