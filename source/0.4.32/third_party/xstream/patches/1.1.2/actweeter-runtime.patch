+"""Provider-first, bounded widget endpoints. Never returns a discovery item.
+
+Called with the existing addon's environment; playback/profile/history remain
+owned by XStream. Provider IDs, rather than fuzzy titles, bind every selection.
+"""
+import hashlib
+import json
+import os
+import re
+import time
+import unicodedata
+from urllib.parse import urlparse
+import content_state
+
+
+def backdrop(value):
+    if isinstance(value, list):
+        return next((u for u in (backdrop(v) for v in value) if u), '')
+    if isinstance(value, str):
+        value = value.strip()
+        parsed = urlparse(value)
+        if parsed.scheme in ('https', 'http') and parsed.netloc:
+            return value
+    return ''
+
+
+def number(value):
+    try:
+        return int(float(value or 0))
+    except (ValueError, TypeError, OverflowError):
+        return 0
+
+
+def premiere_year(offset=0, clock=None):
+    """Return the current/previous premiere year from an injectable clock."""
+    try:
+        now = (clock or time).localtime()
+        return int(now.tm_year) - number(offset)
+    except Exception:
+        return int(time.gmtime().tm_year) - number(offset)
+
+
+def provider_id(item, stype):
+    return str(item.get('series_id' if stype == 'series' else 'stream_id') or '')
+
+
+def resume_key(entry):
+    return hashlib.sha256((entry.get('name', '') + '||' + entry.get('url', '')).encode()).hexdigest()
+
+
+def normalized(title):
+    title = re.sub(r'\s*\(\d{4}\)\s*$', '', str(title or ''))
+    title = unicodedata.normalize('NFKD', title).casefold()
+    return ''.join(c for c in title if c.isalnum())
+
+
+def ranked_provider_items(g, items, stype, section):
+    """External ranking may order provider records, never manufacture them."""
+    key = 'premium_rank_%s_%s_es' % (stype, section)
+    cached = g['_cache_load'](key) or {}
+    if cached.get('expires', 0) > time.time():
+        ranks = cached.get('ranks', [])
+    else:
+        ranks = []
+        try:
+            import trakt
+            import tmdb
+            media = 'tv' if stype == 'series' else 'movie'
+            source = trakt.public_list(section, media).get('results', [])[:20]
+            names = {(normalized(s.get('name')), str(s.get('year') or '')) for s in items}
+            for index, entry in enumerate(source):
+                title, year = entry.get('title', ''), str(entry.get('year') or '')
+                titles = [title]
+                # Bounded localization of ranking names; not a discovery list.
+                if (normalized(title), year) not in names and index < 8:
+                    meta = tmdb.details(media, entry.get('tmdb_id'))
+                    titles.append(meta.get('title') or meta.get('name') or '')
+                ranks.append({'tmdb_id':str(entry.get('tmdb_id') or ''),
+                              'year':year, 'titles':titles})
+            g['_cache_save'](key, {'expires':time.time() + 21600, 'ranks':ranks})
+        except Exception:
+            g['_log']('Premium provider ranking unavailable; no discovery fallback')
+    result, used = [], set()
+    for rank in ranks:
+        target_id = rank.get('tmdb_id')
+        titles = {normalized(t) for t in rank.get('titles', []) if t}
+        matches = [s for s in items if (
+            target_id and str(s.get('tmdb_id') or s.get('tmdb') or '') == target_id)
+            or (rank.get('year') and str(s.get('year') or '') == rank['year']
+                and normalized(s.get('name')) in titles)]
+        # Different editions of one exact title/year are safe; ambiguous titles aren't.
+        identities = {(normalized(s.get('name')), str(s.get('year') or '')) for s in matches}
+        if len(identities) == 1:
+            item = matches[0]
+            sid = provider_id(item, stype)
+            if sid not in used:
+                result.append(item)
+                used.add(sid)
+    return result
+
+
+def enrich(g, item, stype, data, budget):
+    """Exact ID or unique exact title/year. Never adds titles to a collection."""
+    key = 'premium_meta_%s_%s_es' % (stype, provider_id(item, stype))
+    cached = g['_cache_load'](key) or {}
+    if cached.get('expires', 0) > time.time():
+        extra = cached.get('data') or {}
+    elif budget[0] > 0:
+        budget[0] -= 1
+        extra = {}
+        try:
+            import tmdb
+            media = 'tv' if stype == 'series' else 'movie'
+            tmdb_id = data.get('tmdb_id')
+            if not tmdb_id:
+                query = re.sub(r'\s*\(\d{4}\)\s*$', '', item.get('name', ''))
+                matches = [m for m in tmdb.search(media, query).get('results', [])
+                    if normalized(m.get('title')) == normalized(query)
+                    and str(m.get('year')) == str(data.get('year'))
+                    and number(data.get('year'))]
+                if len(matches) == 1:
+                    tmdb_id = matches[0].get('tmdb_id')
+            if tmdb_id:
+                meta = tmdb.details(media, tmdb_id)
+                # ID from provider is authoritative; fuzzy matches never used.
+                if meta.get('id'):
+                    extra['tmdb_id'] = str(meta['id'])
+                    extra['title'] = meta.get('title') or meta.get('name') or ''
+                    extra['plot'] = meta.get('overview') or ''
+                    extra['genre'] = ', '.join(v['name'] for v in meta.get('genres', []) if v.get('name'))
+                    extra['poster_url'] = tmdb.image_url(meta.get('poster_path'))
+                    extra['fanart_url'] = tmdb.fanart_url(meta.get('backdrop_path'))
+                    extra['imdb_id'] = meta.get('imdb_id') or meta.get('external_ids', {}).get('imdb_id') or ''
+                    extra['rating'] = meta.get('vote_average') or ''
+                    extra['tagline'] = meta.get('tagline') or ''
+                    extra['cast'] = [{'name':a.get('name', ''), 'role':a.get('character', ''),
+                                     'thumbnail':tmdb.image_url(a.get('profile_path'))}
+                                    for a in meta.get('credits', {}).get('cast', [])[:10]]
+                    videos = meta.get('videos', {}).get('results', [])
+                    trailer = next((v for v in videos if v.get('site') == 'YouTube'
+                                    and v.get('type') == 'Trailer' and v.get('official')), None)
+                    if trailer:
+                        extra['trailer'] = 'plugin://plugin.video.youtube/play/?video_id=' + trailer['key']
+            g['_cache_save'](key, {'expires':time.time() + (604800 if extra else 86400), 'data':extra})
+        except Exception:
+            # Metadata failure must not prevent provider playback.
+            g['_log']('Premium enrichment unavailable; retaining provider metadata')
+    else:
+        extra = {}
+    provider_fanart = data.get('fanart_url')
+    provider_poster = data.get('poster_url')
+    for key,value in extra.items():
+        if value:
+            data[key] = value
+    if provider_fanart:
+        data['fanart_url'] = provider_fanart
+    if not data.get('poster_url'):
+        data['poster_url'] = provider_poster
+    # Optional exact-ID artwork. One cold request per directory, no discovery.
+    if data.get('tmdb_id'):
+        art_key = 'premium_logo_%s_%s_es' % (stype, data['tmdb_id'])
+        artwork = g['_cache_load'](art_key) or {}
+        if artwork.get('expires', 0) <= time.time() and budget[1] > 0:
+            budget[1] -= 1
+            try:
+                import tmdb
+                media = 'tv' if stype == 'series' else 'movie'
+                images = tmdb._request('/%s/%s/images' % (media, data['tmdb_id']),
+                    {'include_image_language':'es,null,en'}, ttl=168)
+                logos = [a for a in images.get('logos', []) if a.get('file_path')]
+                logos.sort(key=lambda a: ({'es':0, None:1, 'en':2}.get(a.get('iso_639_1'), 3),
+                                           -float(a.get('vote_average') or 0)))
+                artwork = {'expires':time.time() + 604800,
+                           'clearlogo':tmdb.image_url(logos[0]['file_path'], 'w500') if logos else ''}
+                g['_cache_save'](art_key, artwork)
+            except Exception:
+                artwork = {'expires':time.time() + 86400, 'clearlogo':''}
+                g['_cache_save'](art_key, artwork)
+        if artwork.get('expires', 0) > time.time() and artwork.get('clearlogo'):
+            data['clearlogo_url'] = artwork['clearlogo']
+    return data
+
+
+def catalog(g, stype, pnum, *, force_refresh=False):
+    creds = g['_get_credentials_for_profile'](pnum)
+    host, user, password = (creds.get(k, '') for k in
+                            ('xtream_url', 'xtream_username', 'xtream_password'))
+    items = g['_get_cached_xtream_streams'](
+        host, user, password, stype, None,
+        force_refresh=force_refresh, require_fresh=force_refresh)
+    # Record the unfiltered provider catalogue before UI visibility filters.
+    if stype == 'series' and items and host and user and password:
+        try:
+            g['series_changes'].record_catalog(g['addon'], pnum, items)
+        except Exception as exc:
+            g['_log']('Series baseline refresh failed: %s' % exc)
+    categories = g['_get_cached_xtream_categories'](
+        host, user, password, stype,
+        force_refresh=force_refresh, require_fresh=force_refresh)
+    hidden_cats = set(g['_get_hidden_subcats'](stype, pnum))
+    # Premium collections do not bypass parental control or hidden categories.
+    blocked = hidden_cats | {str(c.get('category_id', '')) for c in categories
+                            if g['_is_adult_category'](c.get('category_name', ''))}
+    hidden = set(g['_get_hidden_items'](stype, pnum))
+    return [s for s in items if isinstance(s, dict)
+            and provider_id(s, stype) not in hidden
+            and str(s.get('category_id', '')) not in blocked], (host, user, password)
+
+
+def metadata(g, item, stype, credentials):
+    sid = provider_id(item, stype)
+    if stype == 'movie':
+        data = g['_enrich_movie_info'](item, *credentials)
+        raw = g['_cache_load']('vod_info_' + sid) or {}
+    else:
+        data = g['_enrich_series_info'](item, *credentials)
+        raw = g['_cache_load']('series_info_' + sid) or {}
+    cached = raw.get('info') or {}
+    if not isinstance(cached, dict):
+        cached = {}
+    data['year'] = data.get('year') or item.get('year') or str(
+        item.get('releaseDate') or item.get('release_date') or '')[:4]
+    data['fanart_url'] = backdrop(data.get('fanart_url') or item.get('backdrop_path')
+                                   or cached.get('backdrop_path') or raw.get('backdrop_path'))
+    data['tmdb_id'] = str(data.get('tmdb_id') or cached.get('tmdb_id') or cached.get('tmdb')
+                          or item.get('tmdb_id') or item.get('tmdb') or '')
+    data['imdb_id'] = str(data.get('imdb_id') or cached.get('imdb_id') or '')
+    data['trailer'] = cached.get('youtube_trailer') or item.get('youtube_trailer') or ''
+    data['title'] = item.get('name', '')
+    return data
+
+
+def prepare_series_state_context(g, profile_num):
+    """Load existing read-only series stores once for a provider listing."""
+    try:
+        changes = g['series_changes']
+        return {
+            'inventory': changes.inventory_map(g['addon'], profile_num),
+            'watched': g['WatchedEpisodes'](g['addon'], profile_num=profile_num),
+            'resume': g['ResumePoints'](g['addon'], profile_num=profile_num).get_all(),
+        }
+    except Exception:
+        return None
+
+
+def listitem(g, item, stype, data, label=None, profile_num=None, play_url='',
+             series_context=None):
+    li = g['_new_listitem'](label or data['title'])
+    tag = li.getVideoInfoTag()
+    tag.setMediaType('tvshow' if stype == 'series' else 'movie')
+    tag.setTitle(data['title'])
+    tag.setPlot(data.get('plot') or '')
+    if data.get('tagline'):
+        tag.setTagLine(data['tagline'])
+    trailer = data.get('trailer')
+    if isinstance(trailer, str) and trailer:
+        if re.fullmatch(r'[A-Za-z0-9_-]{11}', trailer):
+            trailer = 'plugin://plugin.video.youtube/play/?video_id=' + trailer
+        if trailer.startswith(('plugin://plugin.video.youtube/', 'https://www.youtube.com/')):
+            tag.setTrailer(trailer)
+    if number(data.get('year')):
+        tag.setYear(number(data['year']))
+    if number(data.get('duration')):
+        tag.setDuration(number(data['duration']))
+    if data.get('genre'):
+        tag.setGenres([s.strip() for s in str(data['genre']).split(',') if s.strip()])
+    try:
+        if data.get('rating'):
+            tag.setRating(float(data['rating']))
+    except (ValueError, TypeError):
+        pass
+    actors = [g['xbmc'].Actor(a.get('name', ''), a.get('role', ''), i,
+                            a.get('thumbnail', ''))
+              for i, a in enumerate(data.get('cast') or []) if a.get('name')]
+    if actors:
+        tag.setCast(actors[:10])
+    ids = {k: str(data[k + '_id']) for k in ('tmdb', 'imdb') if data.get(k + '_id')}
+    if ids:
+        tag.setUniqueIDs(ids, 'tmdb' if 'tmdb' in ids else 'imdb')
+        for key, value in ids.items():
+            li.setProperty(key + '_id', value)
+    art = {}
+    poster = backdrop(data.get('poster_url') or item.get('cover') or item.get('stream_icon'))
+    fanart = backdrop(data.get('fanart_url'))
+    if poster:
+        art.update(poster=poster, icon=poster, thumb=poster)
+    if fanart:
+        art.update(fanart=fanart, landscape=fanart)
+    if backdrop(data.get('clearlogo_url')):
+        art['clearlogo'] = data['clearlogo_url']
+    li.setArt(art)
+    li.setProperty('XStream.ProviderID', provider_id(item, stype))
+    li.setProperty('XStream.ProviderOnly', 'true')
+    li.setProperty('IsPlayable', 'false' if stype == 'series' else 'true')
+    if stype == 'movie' and profile_num is not None:
+        content_state.apply_to_listitem(g, li, 'movie', profile_num,
+            data.get('tmdb_id'), provider_id=provider_id(item, stype), play_url=play_url)
+    elif stype == 'series' and profile_num is not None and series_context:
+        try:
+            sid = provider_id(item, stype)
+            record = series_context['inventory'].get(sid)
+            state_api = g['series_changes'].series_state
+            tmdb_id = state_api.resolve_tmdb_id(record, item, data.get('tmdb_id', ''))
+            state = state_api.derive_series_state(
+                tmdb_id, sid, record, series_context['watched'], series_context['resume'])
+            state_api.apply_to_listitem(li, state)
+        except Exception:
+            g['_log']('Premium series progress unavailable; leaving progress unknown')
+    return li
+
+
+def add_provider_item(g, item, stype, credentials, pnum, budget,
+                      series_context=None, pending=None, reconcile_pending=False):
+    data = enrich(g, item, stype, metadata(g, item, stype, credentials), budget)
+    play_url = (g['IPTV'].build_xtream_stream_url(*credentials, item, 'movie')
+                if stype == 'movie' else '')
+    li = listitem(g, item, stype, data, profile_num=pnum, play_url=play_url,
+                  series_context=series_context)
+    sid = provider_id(item, stype)
+    if reconcile_pending and pending is not None:
+        complete = (content_state.watched_state(
+            g, 'movie', data.get('tmdb_id'), profile_num=pnum) is True
+            if stype == 'movie' else
+            li.getProperty('XStream.SeriesComplete') == 'true')
+        if complete:
+            pending.reconcile_completion(stype, sid, True)
+            return
+    q = ({'mode':'xtream_series', 'series_id':sid, 'profile_num':pnum}
+         if stype == 'series' else {'mode':'premium', 'view':'play', 'stype':stype,
+                                   'id':sid, 'profile_num':pnum})
+    path = g['build_url'](q)
+    favorite_path = (g['IPTV'].build_xtream_stream_url(*credentials, item, 'movie')
+                     if stype == 'movie' else path)
+    favorite_actions = g['_build_favorite_ctx'](
+        sid, item['name'], stype, data.get('poster_url', ''), favorite_path,
+        profile_num=pnum, include_download=False)
+    watched_actions = (content_state.watched_context(
+        g, 'movie', data.get('tmdb_id'), profile_num=pnum) if stype == 'movie' else [])
+    pending_actions = []
+    if pending is not None:
+        label = ('Quitar de Pendiente' if pending.contains(stype, sid)
+                 else 'Añadir a Pendiente')
+        pending_url = g['build_url']({'mode':'premium', 'view':'pending_toggle',
+            'stype':stype, 'id':sid, 'profile_num':pnum})
+        pending_actions.append((label, 'RunPlugin(%s)' % pending_url))
+    content_state.add_context_actions(li, favorite_actions, watched_actions,
+                                      pending_actions)
+    if stype == 'series':
+        status = g['_series_change_status'](sid)
+        if status:
+            li.setProperty('XStream.ChangeStatus', status)
+    g['xbmcplugin'].addDirectoryItem(g['addon_handle'], path, li, stype == 'series')
+
+
+def _search_text(value):
+    value = unicodedata.normalize('NFKD', str(value or '')).casefold()
+    value = ''.join(char for char in value if not unicodedata.combining(char))
+    return ' '.join(re.findall(r'[a-z0-9]+', value))
+
+
+def _search_source_stamp(g, pnum, stype):
+    import os
+    previous = g['pm'].active
+    try:
+        g['pm'].active = str(pnum)
+        path = g['_cache_path']('xtream_streams_' + stype)
+        stat = os.stat(path)
+        return '%d:%d' % (stat.st_mtime_ns, stat.st_size)
+    except (OSError, AttributeError):
+        return 'missing'
+    finally:
+        g['pm'].active = previous
+
+
+def _search_filter_stamp(g, pnum):
+    def values(method, stype):
+        try:
+            return tuple(sorted(str(value) for value in method(stype, pnum)))
+        except Exception:
+            return ()
+    addon = g['addon']
+    adult = addon.getSetting('hide_adult_categories').lower() == 'true'
+    parts = [str(adult)]
+    for stype in ('movie', 'series'):
+        parts.extend((repr(values(g['_get_hidden_subcats'], stype)),
+                      repr(values(g['_get_hidden_items'], stype))))
+    return '|'.join(parts)
+
+
+def _safe_search_art(value):
+    """Do not persist artwork URLs containing provider credentials/tokens."""
+    url = backdrop(value)
+    if not url:
+        return ''
+    parsed = urlparse(url)
+    if parsed.username or parsed.password:
+        return ''
+    if re.search(r'(?:^|[?&])(username|password|token|auth|api[_-]?key)=',
+                 parsed.query, re.IGNORECASE):
+        return ''
+    return url
+
+
+def _search_index_path(g, pnum):
+    import os
+    profile = g['xbmcvfs'].translatePath(g['addon'].getAddonInfo('profile'))
+    return os.path.join(profile, 'provider_search_%s.sqlite' % pnum)
+
+
+def _ensure_search_index(g, pnum, *, force_provider_refresh=False):
+    import os
+    import sqlite3
+    profile = g['xbmcvfs'].translatePath(g['addon'].getAddonInfo('profile'))
+    os.makedirs(profile, exist_ok=True)
+    path = _search_index_path(g, pnum)
+    filter_stamp = _search_filter_stamp(g, pnum)
+    conn = sqlite3.connect(path, timeout=10)
+    conn.execute('CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT)')
+    conn.execute('''CREATE TABLE IF NOT EXISTS items (
+        stype TEXT NOT NULL, provider_id TEXT NOT NULL, title TEXT NOT NULL,
+        norm TEXT NOT NULL, year TEXT, poster TEXT, fanart TEXT, plot TEXT,
+        genre TEXT, rating TEXT, category_id TEXT, category_name TEXT,
+        PRIMARY KEY(stype, provider_id))''')
+    conn.execute('CREATE INDEX IF NOT EXISTS items_type_norm ON items(stype, norm)')
+    results = []
+    snapshots = {}
+    saved_meta = dict(conn.execute('SELECT key, value FROM meta'))
+    for stype in ('movie', 'series'):
+        source_stamp = _search_source_stamp(g, pnum, stype)
+        saved = saved_meta.get(stype)
+        saved_filters = saved_meta.get('filters')
+        if (not force_provider_refresh and saved == source_stamp
+                and saved_filters == filter_stamp and source_stamp != 'missing'):
+            results.append({'scanned':0, 'added':0, 'changed':0, 'removed':0,
+                            'status':'unchanged'})
+            continue
+        started = time.perf_counter()
+        try:
+            items, credentials = catalog(g, stype, pnum,
+                                         force_refresh=force_provider_refresh)
+        except Exception as exc:
+            g['_log']('provider search refresh type=%s status=error error_type=%s' %
+                      (stype, type(exc).__name__))
+            results.append({'scanned':0, 'added':0, 'changed':0, 'removed':0,
+                            'status':'error'})
+            continue
+        if not all(credentials) or not isinstance(items, list):
+            g['_log']('provider search refresh type=%s status=error reason=catalog_unavailable' % stype)
+            results.append({'scanned':0, 'added':0, 'changed':0, 'removed':0,
+                            'status':'error'})
+            continue
+        rows = {}
+        for item in items:
+            sid = provider_id(item, stype)
+            title = str(item.get('name') or item.get('title') or '').strip()
+            norm = _search_text(title)
+            if not sid or not title or not norm:
+                continue
+            rows[sid] = (stype, sid, title, norm,
+                str(item.get('year') or item.get('releaseDate') or '')[:4],
+                _safe_search_art(item.get('stream_icon') or item.get('cover')),
+                _safe_search_art(item.get('backdrop_path')),
+                str(item.get('plot') or ''), str(item.get('genre') or ''),
+                str(item.get('rating') or ''), str(item.get('category_id') or ''),
+                str(item.get('category_name') or ''))
+        old_ids = {str(row[0]) for row in conn.execute(
+            'SELECT provider_id FROM items WHERE stype=?', (stype,))}
+        if old_ids and not rows and saved_filters == filter_stamp:
+            g['_log']('provider search refresh type=%s status=error reason=empty_snapshot_rejected' % stype)
+            results.append({'scanned':0, 'added':0, 'changed':0, 'removed':0,
+                            'status':'error'})
+            continue
+        new_stamp = _search_source_stamp(g, pnum, stype)
+        if new_stamp == 'missing':
+            g['_log']('provider search refresh type=%s status=error reason=cache_unavailable' % stype)
+            results.append({'scanned':0, 'added':0, 'changed':0, 'removed':0,
+                            'status':'error'})
+            continue
+        snapshots[stype] = (rows, old_ids, new_stamp, started)
+
+    if any(result.get('status') == 'error' for result in results):
+        return conn, results
+
+    # Complete both provider snapshots before taking the SQLite write lock.
+    # A Movies success followed by a Series failure therefore commits neither.
+    try:
+        conn.execute('BEGIN IMMEDIATE')
+        for stype, (rows, old_ids, new_stamp, started) in snapshots.items():
+            added = changed = 0
+            for sid, row in rows.items():
+                previous = conn.execute(
+                    'SELECT stype,provider_id,title,norm,year,poster,fanart,plot,genre,rating,category_id,category_name '
+                    'FROM items WHERE stype=? AND provider_id=?', (stype, sid)).fetchone()
+                if previous is None:
+                    added += 1
+                    conn.execute('INSERT INTO items VALUES (?,?,?,?,?,?,?,?,?,?,?,?)', row)
+                elif tuple(previous) != row:
+                    changed += 1
+                    conn.execute('INSERT OR REPLACE INTO items VALUES (?,?,?,?,?,?,?,?,?,?,?,?)', row)
+            removed_ids = old_ids - set(rows)
+            if removed_ids:
+                conn.executemany('DELETE FROM items WHERE stype=? AND provider_id=?',
+                                 ((stype, sid) for sid in removed_ids))
+            conn.execute('INSERT OR REPLACE INTO meta(key,value) VALUES (?,?)',
+                         (stype, new_stamp))
+            conn.execute('INSERT OR REPLACE INTO meta(key,value) VALUES (?,?)',
+                         ('filters', filter_stamp))
+            result = {'scanned':len(rows), 'added':added, 'changed':changed,
+                      'removed':len(removed_ids),
+                      'duration_ms':int((time.perf_counter() - started) * 1000),
+                      'status':'success'}
+            results.append(result)
+            g['_log']('provider search delta type=%s scanned=%d added=%d changed=%d removed=%d ms=%d' %
+                      (stype, result['scanned'], added, changed, len(removed_ids), result['duration_ms']))
+        conn.commit()
+    except Exception:
+        conn.rollback()
+        conn.close()
+        raise
+    return conn, results
+
