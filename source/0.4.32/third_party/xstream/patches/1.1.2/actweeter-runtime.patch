+            item = by_id.get(str(event.get('series_id')))
+            if item:
+                ordered.append(item)
+        items = ordered
+    elif view in ('trending', 'popular'):
+        items = ranked_provider_items(g, items, stype, view)
+    elif view == 'recent':
+        # Series last_modified is NOT an addition date. No invented recency.
+        items = [s for s in items if number(s.get('added')) > 0]
+        items.sort(key=lambda s: number(s.get('added')), reverse=True)
+    elif view in ('year', 'premiere'):
+        year = str(premiere_year(get('offset'))) if view == 'premiere' else get('year')
+        items = [s for s in items if str(s.get('year') or '') == year]
+        if view == 'premiere':
+            plugin.setPluginCategory(handle, 'Estrenos ' + year)
+    elif view == 'genre':
+        genre = get('genre').casefold()
+        items = [s for s in items if genre and genre in str(s.get('genre') or '').casefold()]
+    if get('cat_id'):
+        items = [s for s in items if str(s.get('category_id')) == get('cat_id')]
+    if get('id'):
+        items = [s for s in items if provider_id(s, stype) == get('id')]
+    if get('browse') != '1' and not get('id'):
+        # One card per exact title/year; retain the first provider edition.
+        seen = set()
+        unique = []
+        for item in items:
+            identity = (normalized(item.get('name')), str(item.get('year') or ''))
+            if identity not in seen:
+                seen.add(identity)
+                unique.append(item)
+        items = unique
+    page = max(1, number(get('page', 1)))
+    limit = min(48, max(1, number(get('limit', 24))))
+    offset = (page - 1) * limit
+    selected = items[offset:offset + limit]
+    if stype == 'movie':
+        g['_prefetch_vod_info_batch'](selected, *credentials)
+    plugin.setContent(handle, 'movies' if stype == 'movie' else 'tvshows')
+    series_context = (prepare_series_state_context(g, pnum)
+                      if stype == 'series' and selected else None)
+    for item in selected:
+        add_provider_item(g, item, stype, credentials, pnum, budget,
+                          series_context=series_context, pending=pending,
+                          reconcile_pending=(view == 'pending'))
+    expandable_views = {'catalog', 'recent', 'popular', 'trending', 'favorites',
+                        'pending', 'continue', 'series_recent', 'year', 'premiere', 'genre'}
+    if (get('actweeter_expand') == '1' and stype in ('movie', 'series')
+            and view in expandable_views and len(items) > len(selected)):
+        query = {key: values[0] for key, values in params.items() if values}
+        query.pop('actweeter_expand', None)
+        query['browse'] = '1'
+        query['page'] = '1'
+        query['limit'] = '48'
+        li = g['_new_listitem']('[COLOR FFE50914]EXPANDIR[/COLOR]')
+        li.setProperty('AcTweeteR.Expand', '1')
+        plugin.addDirectoryItem(handle, build(query), li, True)
+    if get('browse') == '1' and offset + limit < len(items):
+        q = {key:values[0] for key,values in params.items()}
+        q['page'] = page + 1
+        li = g['_new_listitem']('Más títulos')
+        plugin.addDirectoryItem(handle, build(q), li, True)
+    plugin.addSortMethod(handle, plugin.SORT_METHOD_NONE)
+    plugin.endOfDirectory(handle, cacheToDisc=False)
diff --git a/resources/lib/recent_tv_native.py b/resources/lib/recent_tv_native.py
new file mode 100644
index 0000000000000000000000000000000000000000..1111d7eb2b7271af9f09d68bf14f4749a525745d
--- /dev/null
+++ b/resources/lib/recent_tv_native.py
@@ -0,0 +1,119 @@
+"""Portable MRU membership: full derived M3U, no duplicate rows or PVR restarts."""
+import json
+import os
+import re
+import time
+
+
+def channel_uid(name, url):
+    value = 0
+    for byte in (name + url).encode('utf-8'):
+        value = ((value * 33) + (byte if byte < 128 else byte - 256)) & 0xffffffff
+    return abs(value if value < 0x80000000 else value - 0x100000000)
+
+
+def transform(source, recent):
+    lines = source.splitlines(keepends=True)
+    count = 0
+    changed = 0
+    for index, line in enumerate(lines):
+        if not line.startswith('#EXTINF'):
+            continue
+        count += 1
+        following = next((v.strip() for v in lines[index + 1:]
+                          if v.strip() and not v.startswith('#')), '')
+        name = line.rsplit(',', 1)[-1].strip()
+        if channel_uid(name, following) not in recent:
+            continue
+        def membership(match):
+            groups = match.group(1).split(';')
+            if 'Últimos Vistos' not in groups:
+                groups.append('Últimos Vistos')
+            return 'group-title="' + ';'.join(groups) + '"'
+        lines[index] = re.sub(r'group-title="([^"]*)"', membership, line, count=1)
+        changed += 1
+    return ''.join(lines), count, changed
+
+
+class RecentTV:
+    def __init__(self, profile, kodi):
+        self.kodi = kodi
+        self.state_path = os.path.join(profile, 'recent_tv_mru.json')
+        self.source = os.path.join(profile, 'pvr_live_xstream_pro_p1.m3u8')
+        self.target = os.path.join(profile, 'pvr_recent_native.m3u8')
+        self.current = None
+        self.pending = 0
+        self.ui_refresh_pending = False
+        self.source_stamp = None
+        try:
+            with open(self.state_path, encoding='utf-8') as stream:
+                self.recent = json.load(stream)['channels'][:25]
+        except (OSError, ValueError, KeyError, TypeError):
+            self.recent = []
+        self.pending = time.monotonic() - 16
+
+    def call(self, method, params):
+        result = json.loads(self.kodi.executeJSONRPC(json.dumps(
+            {'jsonrpc': '2.0', 'id': 1, 'method': method, 'params': params})))
+        return result.get('result', {})
+
+    def tick(self):
+        try:
+            source_stat = os.stat(self.source)
+            stamp = (source_stat.st_mtime_ns, source_stat.st_size)
+            if stamp != self.source_stamp:
+                self.source_stamp = stamp
+                self.pending = time.monotonic()
+        except OSError:
+            pass
+        players = self.call('Player.GetActivePlayers', {})
+        active = next((p['playerid'] for p in players if p.get('type') == 'video'), None)
+        uid = None
+        if active is not None:
+            item = self.call('Player.GetItem', {'playerid': active}).get('item', {})
+            if item.get('type') == 'channel':
+                detail = self.call('PVR.GetChannelDetails', {
+                    'channelid': item['id'], 'properties': ['uniqueid']})
+                uid = detail.get('channeldetails', {}).get('uniqueid')
+        if uid and uid != self.current:
+            self.recent = [int(uid)] + [v for v in self.recent if v != int(uid)]
+            self.recent = self.recent[:25]
+            self._atomic(self.state_path, json.dumps({'channels': self.recent}, sort_keys=True))
+            self.pending = time.monotonic()
+            token = '%d-%d' % (int(uid), int(time.monotonic() * 1000))
+            self.kodi.executebuiltin('SetProperty(Premium.RecentTVRefresh,%s,home)' % token)
+            self.ui_refresh_pending = True
+        self.current = uid
+        if self.ui_refresh_pending and active is None:
+            try:
+                if self.kodi.getCondVisibility('Window.IsActive(home)'):
+                    self.kodi.executebuiltin('Container.Refresh')
+                    self.ui_refresh_pending = False
+            except Exception:
+                pass
+        # Flush only while idle, not during a zap or playback. IPTV Simple polls normally.
+        if active is None and self.pending and time.monotonic() - self.pending >= 15:
+            try:
+                with open(self.source, encoding='utf-8') as stream:
+                    original = stream.read()
+                derived, count, changed = transform(original, set(self.recent))
+                if count < 1:
+                    return
+                existing = ''
+                if os.path.exists(self.target):
+                    with open(self.target, encoding='utf-8') as stream:
+                        existing = stream.read()
+                if derived != existing:
+                    self._atomic(self.target, derived)
+                    self.kodi.log('[Xstream Pro] Recent TV membership refreshed: %d unique history entries' % len(self.recent), self.kodi.LOGINFO)
+                self.pending = 0
+            except OSError:
+                self.kodi.log('[Xstream Pro] Recent TV playlist unavailable; original remains intact', self.kodi.LOGWARNING)
+
+    @staticmethod
+    def _atomic(path, content):
+        temporary = path + '.tmp'
+        with open(temporary, 'w', encoding='utf-8') as stream:
+            stream.write(content)
+        os.chmod(temporary, 0o600)
+        os.replace(temporary, path)
diff --git a/resources/lib/recent_tv_ui.py b/resources/lib/recent_tv_ui.py
new file mode 100644
index 0000000000000000000000000000000000000000..cfdc8f201b01ef74f30175a395ef08cadfc131f9
--- /dev/null
+++ b/resources/lib/recent_tv_ui.py
@@ -0,0 +1,146 @@
+"""Read-only XStream MRU presentation adapter backed by Kodi PVR identity."""
+import json
+import os
+
+
+def ordered_channels(uids, channels):
+    """Join MRU UIDs to Kodi channels, preserving order and removing duplicates."""
+    by_uid = {}
+    for channel in channels or []:
+        if not isinstance(channel, dict):
+            continue
+        uid = channel.get('uniqueid')
+        if uid is None or channel.get('channeltype', 'tv') != 'tv' or channel.get('hidden'):
+            continue
+        by_uid.setdefault(str(uid), channel)
+    result, seen = [], set()
+    for raw_uid in uids or []:
+        if isinstance(raw_uid, bool):
+            continue
+        try:
+            uid = str(int(raw_uid))
+        except (TypeError, ValueError, OverflowError):
+            continue
+        if uid in seen:
+            continue
+        seen.add(uid)
+        channel = by_uid.get(uid)
+        if channel and channel.get('channelid') is not None:
+            result.append(channel)
+    return result
+
+
+def _mru_path(g):
+    profile = g['addon'].getAddonInfo('profile')
+    profile = g['xbmcvfs'].translatePath(profile)
+    return os.path.join(profile, 'recent_tv_mru.json')
+
+
+def _read_uids(g):
+    try:
+        with open(_mru_path(g), encoding='utf-8') as stream:
+            data = json.load(stream)
+        values = data.get('channels', []) if isinstance(data, dict) else []
+        return values if isinstance(values, list) else []
+    except (OSError, ValueError, TypeError):
+        return []
+
+
+def _rpc(g, method, params):
+    request = {'jsonrpc':'2.0', 'id':1, 'method':method, 'params':params}
+    try:
+        response = json.loads(g['xbmc'].executeJSONRPC(json.dumps(request)))
+        if response.get('error'):
+            g['_log']('Recent TV Kodi API failed method=%s code=%s' %
+                      (method, response['error'].get('code', 'unknown')))
+            return None
+        return response.get('result')
+    except Exception as exc:
+        g['_log']('Recent TV Kodi API failed method=%s error_type=%s' %
+                  (method, type(exc).__name__))
+        return None
+
+
+def _channel_listitem(g, channel, pnum):
+    name = str(channel.get('channel') or channel.get('label') or '')
+    channel_id = int(channel['channelid'])
+    uid = int(channel['uniqueid'])
+    li = g['_new_listitem'](name)
+    number = channel.get('channelnumber')
+    if number not in (None, 0, ''):
+        li.setLabel2(str(number))
+    art = channel.get('thumbnail') or channel.get('icon') or ''
+    if art:
+        li.setArt({'thumb':art, 'icon':art})
+    tag = li.getVideoInfoTag()
+    tag.setTitle(name)
+    tag.setMediaType('video')
+    now = channel.get('broadcastnow') or {}
+    next_program = channel.get('broadcastnext') or {}
+    if now.get('plot'):
+        tag.setPlot(now['plot'])
+    if now.get('genre'):
+        tag.setGenres([now['genre']])
+    if now.get('title'):
+        li.setProperty('PVR.BroadcastNow', str(now['title']))
+    if next_program.get('title'):
+        li.setProperty('PVR.BroadcastNext', str(next_program['title']))
+    li.setProperty('PVR.ChannelId', str(channel_id))
+    li.setProperty('PVR.ChannelUID', str(uid))
+    li.setProperty('IsPlayable', 'true')
+    path = g['build_url']({'mode':'premium', 'view':'recent_tv_play',
+                           'channelid':channel_id, 'profile_num':pnum})
+    return path, li
+
+
+def _directory(g, pnum):
+    response = _rpc(g, 'PVR.GetChannels', {
+        'channelgroupid':'alltv',
+        'properties':['channel', 'channeltype', 'channelnumber', 'uniqueid',
+                      'thumbnail', 'icon', 'hidden', 'broadcastnow', 'broadcastnext'],
+        'limits':{'start':0, 'end':10000},
+    })
+    channels = ordered_channels(_read_uids(g), response.get('channels', [])) \
+        if isinstance(response, dict) else []
+    plugin, handle = g['xbmcplugin'], g['addon_handle']
+    plugin.setContent(handle, 'livetv')
+    plugin.setPluginCategory(handle, 'Últimos vistos')
+    for channel in channels:
+        path, li = _channel_listitem(g, channel, pnum)
+        plugin.addDirectoryItem(handle, path, li, False)
+    plugin.addSortMethod(handle, plugin.SORT_METHOD_NONE)
+    plugin.endOfDirectory(handle, succeeded=True, updateListing=False, cacheToDisc=False)
+
+
+def _play(g, params):
+    get = lambda key, default='': params.get(key, [default])[0]
+    try:
+        channel_id = int(get('channelid'))
+    except (TypeError, ValueError, OverflowError):
+        channel_id = 0
+    uid = None
+    if channel_id > 0:
+        detail = _rpc(g, 'PVR.GetChannelDetails', {
+            'channelid':channel_id, 'properties':['uniqueid', 'channeltype', 'hidden']})
+        channel = detail.get('channeldetails', {}) if isinstance(detail, dict) else {}
+        if channel.get('channeltype', 'tv') == 'tv' and not channel.get('hidden'):
+            try:
+                uid = int(channel.get('uniqueid'))
+            except (TypeError, ValueError, OverflowError):
+                uid = None
+    if uid is None or uid not in set(_read_uids(g)):
+        g['xbmcplugin'].setResolvedUrl(g['addon_handle'], False, g['_new_listitem'](''))
+        return
+    result = _rpc(g, 'Player.Open', {'item':{'channelid':channel_id}})
+    if result is None:
+        g['xbmcplugin'].setResolvedUrl(g['addon_handle'], False, g['_new_listitem'](''))
+        return
+    g['xbmcplugin'].endOfDirectory(g['addon_handle'], succeeded=True,
+                                   updateListing=False, cacheToDisc=False)
+
+
+def dispatch(g, params, pnum, view):
+    if view == 'recent_tv':
+        _directory(g, pnum)
+    else:
+        _play(g, params)
