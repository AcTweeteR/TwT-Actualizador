+def _search_rows(conn, query):
+    terms = _search_text(query).split()
+    if not terms:
+        return []
+    clauses = ' AND '.join('norm LIKE ?' for _ in terms)
+    phrase = ' '.join(terms)
+    rows = conn.execute(
+        'SELECT stype,provider_id,title,norm,year,poster,fanart,plot,genre,rating '
+        'FROM items WHERE ' + clauses +
+        ' ORDER BY CASE WHEN norm=? THEN 0 WHEN norm LIKE ? THEN 1 ELSE 2 END,'
+        ' title COLLATE NOCASE LIMIT 800',
+        tuple('%%%s%%' % term for term in terms) + (phrase, phrase + '%')).fetchall()
+    def rank(row):
+        title = row[3]
+        if title == ' '.join(terms):
+            score = 0
+        elif title.startswith(' '.join(terms)):
+            score = 1
+        else:
+            words = title.split()
+            score = 2 if all(any(word.startswith(term) for word in words)
+                             for term in terms) else 3
+        return score, 0 if row[0] == 'movie' else 1, title
+    return sorted(rows, key=rank)[:24]
+
+
+def _add_search_result(g, row, pnum):
+    stype, sid, title, _norm, year, poster, fanart, plot, genre, rating = row
+    item = {'stream_id' if stype == 'movie' else 'series_id': sid,
+            'name': title, 'year': year, 'stream_icon': poster, 'cover': poster,
+            'backdrop_path': fanart, 'plot': plot, 'genre': genre, 'rating': rating}
+    data = {'title': title, 'year': year, 'poster_url': poster, 'fanart_url': fanart,
+            'plot': plot, 'genre': genre, 'rating': rating}
+    raw = g['_cache_load'](('vod_info_' if stype == 'movie' else 'series_info_') + sid) or {}
+    if not isinstance(raw, dict):
+        raw = {}
+    provider_info = raw.get('info') if isinstance(raw, dict) else {}
+    if not isinstance(provider_info, dict):
+        provider_info = {}
+    provider_fanart = backdrop(item.get('backdrop_path') or
+                               provider_info.get('backdrop_path') or
+                               raw.get('backdrop_path'))
+    if provider_fanart:
+        data['fanart_url'] = provider_fanart
+    cached = g['_cache_load']('premium_meta_%s_%s_es' % (stype, sid)) or {}
+    extra = cached.get('data') if cached.get('expires', 0) > time.time() else {}
+    if isinstance(extra, dict):
+        for key in ('title', 'plot', 'year', 'genre', 'rating', 'duration', 'tagline',
+                    'cast', 'tmdb_id', 'imdb_id', 'trailer', 'poster_url', 'fanart_url',
+                    'clearlogo_url'):
+            if extra.get(key):
+                data[key] = extra[key]
+    if provider_fanart:
+        data['fanart_url'] = provider_fanart
+    if not data.get('poster_url'):
+        data['poster_url'] = poster
+    li = listitem(g, item, stype, data, profile_num=pnum)
+    if stype == 'series':
+        path = g['build_url']({'mode':'xtream_series', 'series_id':sid,
+                               'profile_num':pnum})
+        status = g['_series_change_status'](sid)
+        if status:
+            li.setProperty('XStream.ChangeStatus', status)
+    else:
+        path = g['build_url']({'mode':'premium', 'view':'play', 'stype':'movie',
+                               'id':sid, 'profile_num':pnum})
+    li.setProperty('path', path)
+    favorite_actions = g['_build_favorite_ctx'](
+        sid, title, stype, poster, path, profile_num=pnum, include_download=False)
+    watched_actions = (content_state.watched_context(
+        g, 'movie', data.get('tmdb_id'), profile_num=pnum) if stype == 'movie' else [])
+    pending_actions = []
+    pending_module = g.get('pending_adapter')
+    if pending_module is not None:
+        pending = pending_module.PendingAdapter(g['_get_profile_fav'](pnum))
+        label = ('Quitar de Pendiente' if pending.contains(stype, sid)
+                 else 'Añadir a Pendiente')
+        pending_url = g['build_url']({'mode':'premium', 'view':'pending_toggle',
+            'stype':stype, 'id':sid, 'profile_num':pnum})
+        pending_actions.append((label, 'RunPlugin(%s)' % pending_url))
+    content_state.add_context_actions(li, favorite_actions, watched_actions,
+                                      pending_actions)
+    g['xbmcplugin'].addDirectoryItem(g['addon_handle'], path, li, stype == 'series')
+
