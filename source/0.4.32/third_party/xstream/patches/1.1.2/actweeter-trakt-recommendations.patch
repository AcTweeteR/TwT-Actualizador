 def unified_search(query, stype=None):
+    # Reuse the catalog index already maintained by premium browsing.
+    # Missing/stale indices deliberately fall back to the existing search.
+    def indexed_search(media):
+        # Legacy substring matching includes punctuation and accents. Only
+        # use normalized SQLite keys for plain ASCII alphanumeric queries.
+        if not query or not query.isascii() or not query.isalnum():
+            return None
+        try:
+            from provider_catalog_index import CatalogIndex, IndexUnavailable, schedule_rebuild
+            pnum = int(pm.active)
+            cache_key = "xtream_streams_" + media
+            if not _cache_valid(cache_key, profile_num=pnum):
+                return None
+            source = _catalog_provider_source(pnum)
+            if not all(source.split("|", 2)):
+                return None
+            path = _cache_path(cache_key, pnum)
+            try:
+                index = CatalogIndex(path, source, pnum, media, build=False)
+            except IndexUnavailable:
+                schedule_rebuild(path, source, pnum, media)
+                return None
+            # Keep original search visibility semantics: hide adult titles,
+            # not whole categories, and preserve the provider's item order.
+            matches = index.search(query, limit=101)
+            # A capped index response cannot replace the complete legacy
+            # search; retain all results when the query is too broad.
+            return None if len(matches) >= 100 else matches
+        except Exception as exc:
+            _log("Indexed search fallback (%s): %s" % (media, type(exc).__name__))
+            return None
+
