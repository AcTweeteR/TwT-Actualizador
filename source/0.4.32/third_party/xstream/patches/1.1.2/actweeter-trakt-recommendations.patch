+_PROVIDER_MATCH_MEMO = {"cache": None, "matches": {}}
+
+def _provider_match_cached(item, cache, strict_title_year=False):
+    """Shared constant-time repeated identity checks for provider widgets."""
+    memo = _PROVIDER_MATCH_MEMO
+    if memo["cache"] is not cache:
+        memo["cache"], memo["matches"] = cache, {}
+    media = item.get("tmdb_type")
+    title = item.get("showtitle") or item.get("tvshowtitle") or item.get("title") or item.get("name")
+    year = _provider_year(item.get("year"), item.get("release_date"), item.get("first_air_date"), item.get("premiered"))
+    key = (media, str(item.get("tmdb_id") or ""), _provider_title_key(title), year, strict_title_year)
+    matches = memo["matches"]
+    if len(matches) >= 8192:
+        matches.clear()
+    if key not in matches:
+        matches[key] = _provider_availability_item_available(item, cache, strict_title_year=strict_title_year)
+    return matches[key]
+
+def _filter_provider_trakt_recommendations(items):
+    """Use the same provider identity/title-year matcher as TMDb routes."""
+    # Never fetch or rebuild the provider inventory inside a widget directory
+    # request: catalogue refresh owns that work and updates this cache.
+    cache = _load_provider_availability_cache()
+    if not cache or not any((cache.get(kind) or {}).get("titles") for kind in ("movie", "tv")):
+        return []
+    filtered = []
+    for item in items or []:
+        media_type = item.get("tmdb_type")
+        if media_type not in ("movie", "tv"):
+            continue
+        if _provider_match_cached(item, cache, strict_title_year=True):
+            filtered.append(item)
+    return filtered
+
