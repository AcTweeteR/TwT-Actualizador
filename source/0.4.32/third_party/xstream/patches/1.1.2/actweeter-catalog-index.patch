+def indexed_movie_page(g, pnum, view, get):
+    """Use a derived offset index for warm movie catalogs; None keeps legacy fallback."""
+    if view not in ('catalog', 'recent', 'popular', 'trending'):
+        return None
+    try:
+        from provider_catalog_index import CatalogIndex
+        creds = g['_get_credentials_for_profile'](pnum)
+        host, user, password = (creds.get(key, '') for key in
+                                ('xtream_url', 'xtream_username', 'xtream_password'))
+        if not all((host, user, password)):
+            return None
+        cache_key = 'xtream_streams_movie'
+        if not g['_cache_valid'](cache_key):
+            return None
+        cached_ranks = None
+        if view in ('popular', 'trending'):
+            rank_key = 'premium_rank_movie_%s_es' % view
+            cached_ranks = g['_cache_load'](rank_key) or {}
+            if cached_ranks.get('expires', 0) <= time.time():
+                return None
+        cache_path = g['_cache_path'](cache_key)
+        categories = g['_get_cached_xtream_categories'](host, user, password, 'movie')
+        blocked = set(g['_get_hidden_subcats']('movie', pnum))
+        blocked.update(str(category.get('category_id', '')) for category in categories
+                       if g['_is_adult_category'](category.get('category_name', '')))
+        hidden = set(g['_get_hidden_items']('movie', pnum))
+        index = _performance_call(g, 'catalog_index.open', CatalogIndex, cache_path,
+            '%s|%s|%s' % (host, user, password), pnum, 'movie')
+        trace = g.get('_performance')
+        if trace is not None:
+            trace.count('catalog_index.hit' if index.reused else 'catalog_index.build')
+            if index.invalidated:
+                trace.count('catalog_index.invalidated')
+            trace.count('catalog_index.items', index.item_count)
+            trace.count('catalog_index.bytes', os.path.getsize(index.path))
+        args = {'blocked_categories': blocked, 'hidden_ids': hidden,
+                'category': get('cat_id'), 'provider_id': get('id'),
+                'browse': get('browse') == '1', 'page': number(get('page', 1)),
+                'limit': number(get('limit', 24))}
+        if view in ('popular', 'trending'):
+            result = _performance_call(g, 'catalog_index.query', index.ranked,
+                cached_ranks.get('ranks') or [], **args)
+        else:
+            result = _performance_call(g, 'catalog_index.query', index.page,
+                mode='recent' if view == 'recent' else 'catalog', **args)
+        return result[0], result[1], (host, user, password)
+    except Exception as exc:
+        g['_log']('Movie catalog index unavailable; using original path error_type=%s' %
+                  type(exc).__name__)
+        return None
+
