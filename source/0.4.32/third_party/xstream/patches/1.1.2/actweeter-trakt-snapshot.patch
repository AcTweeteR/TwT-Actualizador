+def snapshot_request(path, params=None):
+    """Snapshot GET only: never refresh OAuth or convert invalid JSON to empty."""
+    if path not in {'/users/settings', '/sync/last_activities',
+                    '/sync/watched/movies', '/sync/watched/shows',
+                    '/sync/history/movies', '/sync/history/episodes',
+                    '/sync/playback/movies', '/sync/playback/episodes'}:
+        raise ValueError("Unsupported snapshot endpoint")
+    resp = _http_request("GET", BASE_URL + path, params=params or {},
+                         headers=_headers(True), timeout=20)
+    if resp.status_code >= 400:
+        _raise_trakt_error(resp, "snapshot GET")
+    payload = resp.json()
+    if isinstance(payload, list):
+        metadata = {key: int(resp.headers["X-Pagination-" + name]) for key, name in (
+            ("page", "Page"), ("limit", "Limit"), ("page_count", "Page-Count"),
+            ("item_count", "Item-Count"))}
+        return payload, metadata
+    return payload, 1
+
+
 def cached_request(path, params=None, auth=True, ttl=300):
     cache_key = cache.make_key(path, sorted((params or {}).items()), bool(auth))
