+def _instrument_phase(name, function):
+    def measured(g, *args, **kwargs):
+        trace = g.get('_performance')
+        if trace is None:
+            return function(g, *args, **kwargs)
+        return trace.call(name, function, g, *args, **kwargs)
+    return measured
+
+
+for _function_name, _phase_name in (
+        ('dispatch', 'directory.dispatch'),
+        ('catalog', 'provider.catalog'),
+        ('ranked_provider_items', 'provider.ranking'),
+        ('metadata', 'metadata.provider'),
+        ('enrich', 'metadata.tmdb_enrichment'),
+        ('listitem', 'listitem.build'),
+        ('add_provider_item', 'listitem.complete'),
+        ('prepare_series_state_context', 'storage.series_state_read')):
+    globals()[_function_name] = _instrument_phase(
+        _phase_name, globals()[_function_name])
