+def _search_refresh_error(exc):
+    import datetime
+    import email.utils
+    import socket
+    import urllib.error
+    current = exc
+    seen = set()
+    status, headers, auth_error = None, None, False
+    error_types = set()
+    message = ''
+    while current is not None and id(current) not in seen:
+        seen.add(id(current))
+        auth_error = auth_error or type(current).__name__ == 'ProviderAuthError'
+        error_types.add(type(current).__name__)
+        message += ' ' + str(current).casefold()
+        response = getattr(current, 'response', None)
+        status = (getattr(current, 'code', None) or
+                  getattr(response, 'status_code', None) or status)
+        headers = (getattr(current, 'headers', None) or
+                   getattr(response, 'headers', None) or headers)
+        current = getattr(current, '__cause__', None) or getattr(current, '__context__', None)
+    if status is None:
+        import re
+        match = re.search(r'\b(401|403|408|429|504)\b', message)
+        status = int(match.group(1)) if match else None
+    if status in (401, 403) or auth_error or any(
+            marker in message for marker in ('auth failed', 'auth error', 'expired',
+                                             'credentials unavailable', 'banned', 'disabled')):
+        category = 'authentication'
+    elif status == 429:
+        category = 'rate_limited'
+    elif (status in (408, 504)
+          or error_types.intersection(('Timeout', 'ConnectTimeout', 'ReadTimeout',
+                                       'TimeoutError', 'socket.timeout'))
+          or isinstance(exc, (TimeoutError, socket.timeout))
+          or 'timed out' in message or 'timeout' in message):
+        category = 'timeout'
+    elif (isinstance(exc, urllib.error.URLError)
+          or error_types.intersection(('ConnectionError', 'ConnectError',
+                                       'NameResolutionError', 'URLError'))
+          or 'connectionerror' in message or 'failed to establish a new connection' in message
+          or 'name resolution' in message):
+        category = 'connection'
+    else:
+        category = 'incomplete'
+    retry_after = 0
+    value = headers.get('Retry-After') if headers is not None else None
+    if value:
+        try:
+            retry_after = max(0, int(float(value)))
+        except (TypeError, ValueError):
+            try:
+                target = email.utils.parsedate_to_datetime(value)
+                if target.tzinfo is None:
+                    target = target.replace(tzinfo=datetime.timezone.utc)
+                retry_after = max(0, int((target - datetime.datetime.now(
+                    datetime.timezone.utc)).total_seconds()))
+            except (TypeError, ValueError, OverflowError):
+                retry_after = 0
+    return category, retry_after
+
+
