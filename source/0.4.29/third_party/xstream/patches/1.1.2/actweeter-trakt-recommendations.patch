@@ -2270,3 +2270,21 @@
     if not cache:
         return []
     return [item for item in (items or []) if _provider_availability_item_available(item, cache)]
+
+def _filter_provider_trakt_recommendations(items):
+    """Fail closed: require an exact TMDb ID in the provider inventory."""
+    # Never fetch or rebuild the provider inventory inside a widget directory
+    # request: catalogue refresh owns that work and updates this cache.
+    cache = _load_provider_availability_cache()
+    if not cache:
+        return []
+    filtered = []
+    for item in items or []:
+        media_type = item.get("tmdb_type")
+        if media_type not in ("movie", "tv"):
+            continue
+        tmdb_id = str(item.get("tmdb_id") or "").strip()
+        if tmdb_id and tmdb_id in _provider_tmdb_id_set(cache, media_type):
+            filtered.append(item)
+    return filtered
+
