<?xml version="1.0" encoding="utf-8"?>
<!-- BINGIE -->
<window>
    <defaultcontrol always="true">1000</defaultcontrol>
    <menucontrol>900</menucontrol>

    <!-- Defaults -->
    <include>DefaultSkinSettings</include>
    
	<!-- BINGIE -->
    <onload>Skin.SetString(TMDbBingieHelper.MonitorContainer,17195)</onload>
	<onload condition="!Skin.HasSetting(EnableRatings)">Skin.SetBool(TMDbBingieHelper.DisableRatings)</onload>
    <onload condition="Skin.HasSetting(EnableRatings)">Skin.Reset(TMDbBingieHelper.DisableRatings)</onload>
	
	<!-- Build Menu -->
    <onload>RunScript(script.skinshortcuts,type=buildxml&amp;mainmenuID=900&amp;levels=1&amp;group=mainmenu|powermenu|searchmenu|tmdbsearchmenu|moviehub|tvshowhub|newhub|musichub|customhub|somethinghub|mylisthub)</onload>
    <onload condition="String.IsEmpty(Window(Home).Property(widgetstyle))">SetProperty(widgetstyle,$INFO[Skin.String(widgetstyle)])</onload>
	<onload>Skin.TimerStart(spotlightanimation)</onload>

    <!-- One AcTweeteR first-run flow; legacy BINGIE dialogs remain available only as compatibility code. -->
	<onload>RunScript(service.actweeter,first_run)</onload>
    <onunload>SetProperty(SectionBackground,$ESCINFO[Control.GetLabel(99004)])</onunload>
    <onunload condition="System.HasAlarm(preview_delay)">CancelAlarm(preview_delay,silent)</onunload>
    <onunload condition="System.HasAddon(slyguy.trailers)">ClearProperty(ACTWEETER_AUTO_PREVIEW_REQUEST,Home)</onunload>
    <onunload condition="System.HasAddon(slyguy.trailers)">RunScript(service.actweeter,preview_exit)</onunload>
    <!-- SlyGuy previews are stopped by the ownership-aware service, never by a generic media classification. -->
    <onunload condition="!System.HasAddon(slyguy.trailers) + $EXP[IsPlayingUnrecognizedContent] + String.IsEmpty(Window(Home).Property(SLYGUY_TRAILER_RETURN_PENDING))">PlayerControl(Stop)</onunload>
    <onunload>ClearProperty(submenu,Home)</onunload>
    <onunload>ClearProperty(ShowViewSubMenu,Home)</onunload>
    <include>BingieViews_WindowOpen_Fade</include>

	<controls>
		<include>Defs_TMDbBingieHelper_Loader</include>
		<!-- Global Background -->
        <include>GlobalBackground</include>     
        <control type="button" id="1000">
            <include>HiddenObject</include>
            <!-- The first Home focus belongs to the always-available menu, not a widget group
                 whose children can be visible only because their providers are still updating. -->
            <onfocus condition="String.IsEmpty(Window(Home).Property(HomeFirstLoadDone))">SetFocus(900)</onfocus>
            <!-- Restore a widget only after its group has settled; otherwise recover to the menu. -->
            <onfocus condition="!String.IsEmpty(Window(Home).Property(HomeFirstLoadDone)) + !String.IsEmpty(Window(Home).Property(LastFocusWidget)) + $EXP[HomeHasVisibleWidgets]">SetFocus(77777)</onfocus>
            <onfocus condition="!String.IsEmpty(Window(Home).Property(HomeFirstLoadDone)) + [String.IsEmpty(Window(Home).Property(LastFocusWidget)) | !$EXP[HomeHasVisibleWidgets]]">SetFocus(900)</onfocus>
            <onfocus condition="String.IsEmpty(Window(Home).Property(HomeFirstLoadDone))">SetProperty(HomeFirstLoadDone,1)</onfocus>
            <onleft>900</onleft>
            <onright>900</onright>
            <onback>900</onback>
        </control>

        <!-- Preload Weather Conditions -->
        <control type="label">
            <label>$INFO[Weather.Conditions]</label>
            <include>HiddenObject</include>
        </control>

        <!-- Preload submenu for count calculations -->
        <include condition="!Skin.HasSetting(DisableAllSubmenus)">hiddenSubmenu</include>    
	
		<!-- Home Screen -->
        <include>HomeBingie</include>

		<!-- Debug -->
        <include condition="Skin.HasSetting(DebugGrid) | Skin.HasSetting(DebugInfo)">DebugInfo</include>
        <include>AcTweeteR_TouchDiagnosticsOverlay</include>
    </controls>
</window>
