</addon><addon id="service.actweeter" name="AcTweeteR Service" version="0.2.2" provider-name="AcTweeteR maintainers">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
  </requires>
  <extension point="xbmc.service" library="service.py" start="startup" />
  <extension point="xbmc.python.script" library="setup.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">AcTweeteR search, setup and service-status helper</summary>
    <summary lang="es_ES">Ayudante de búsqueda, configuración y estado de servicios de AcTweeteR</summary>
    <description lang="en_GB">Schedules provider-only XStream search-index refreshes and offers an on-demand first-run wizard and diagnostics. Credentials remain in official add-on settings.</description>
    <description lang="es_ES">Programa actualizaciones del índice XStream y ofrece un asistente inicial y diagnósticos bajo demanda. Las credenciales permanecen en los ajustes oficiales de cada complemento.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <news>changelog-0.2.2.txt</news>
  </extension>
</addon></addons>
