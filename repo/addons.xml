		<import version="5.17.0" addon="xbmc.gui" />
		<import addon="script.bingie.helper" version="1.1.2" />
		<import addon="script.bingie.toolbox" version="1.0.0" />
		<import addon="script.bingie.widgets" version="1.0.1" />
		<import addon="script.skinshortcuts" version="2.0.3" />
		<import addon="service.actweeter" version="0.2.2" />
		<import addon="resource.images.studios.coloured" version="0.0.24" />
		<import addon="plugin.video.tmdb.bingie.helper" version="1.0.1" />
		<import addon="plugin.program.autocompletion" version="2.1.2" />
	</requires>
	<extension debugging="false" defaultthemename="Textures.xbt" effectslowdown="1" point="xbmc.gui.skin">
        <res aspect="16:9" default="true" folder="1080i" height="1080" width="1920" />
    </extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">AcTweeteR streaming interface for Kodi.</summary>
		<summary lang="zh_CN">AcTweeteR Kodi 流媒体界面。</summary>
		<summary lang="es_ES">Kodi con una interfaz cinematográfica y personalizable.</summary>
		<summary lang="es_AR">Kodi con una interfaz cinematográfica y personalizable.</summary>
		<summary lang="es_MX">Kodi con una interfaz cinematográfica y personalizable.</summary>
		<description lang="en_GB">AcTweeteR – a locally maintained streaming interface for movies, series and live TV.</description>
		<description lang="zh_CN">AcTweeteR - 电影、剧集和电视的流媒体界面。</description>
		<description lang="es_ES">AcTweeteR - tu espacio de películas, series y televisión.</description>
		<description lang="es_AR">AcTweeteR - tu espacio de películas, series y televisión.</description>
		<description lang="es_MX">AcTweeteR - tu espacio de películas, series y televisión.</description>
		<platform>all</platform>
		<license>GPL v2.0</license>
		<news>changelog-1.2.3.txt</news>
		<forum />
